# Copiar a .env.local (desarrollo) o configurar como variables de entorno
# reales en el contenedor Docker (producción). Sin estas variables, el
# formulario de contacto sigue validando pero /api/contact responde error
# al intentar enviar, porque no hay con qué mandar el correo.

# Servidor SMTP para enviar los correos del formulario de contacto.
# Ejemplo con Gmail: host smtp.gmail.com, puerto 587, y SMTP_PASS debe ser
# una "contraseña de aplicación" de Gmail (no la contraseña normal de la
# cuenta) — se genera en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente del correo (normalmente debe coincidir con SMTP_USER para que
# el proveedor SMTP no lo rechace). Si se deja vacío, se usa SMTP_USER.
CONTACT_EMAIL_FROM=

# A quién le llegan las cotizaciones del formulario. Cambiar aquí cuando
# se defina el correo definitivo — no requiere tocar código.
CONTACT_EMAIL_TO=calderonbegazo@gmail.com
